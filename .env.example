# Copy this file to .env and adjust values for local development.
# Never commit a real .env file or a real API key.

APP_NAME=agentic-commerce-platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# The current phase still supports only the offline mock provider.
LLM_PROVIDER=mock
# Leave empty unless a later phase adds a real provider.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=mock-llm-v1

# Phase-four persistence and retrieval.
DATABASE_URL=sqlite:///./data/agentic_commerce.db
DATABASE_ECHO=false
USE_REAL_ADAPTERS=false
SEED_DEMO_DATA=true

# Redis is optional. When disabled or unavailable, InMemoryMemoryStore is used.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=agentic-commerce
PROFILE_CACHE_TTL_SECONDS=300
SESSION_CONTEXT_TTL_SECONDS=1800

# Local deterministic vector index; no external vector database is required.
VECTOR_STORE_TYPE=local
VECTOR_COLLECTION_NAME=products
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=deterministic-hash-v1
EMBEDDING_DIMENSIONS=64
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.05
